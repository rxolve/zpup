{
  "name": "@zpup/core",
  "version": "0.1.0",
  "description": "A modern, AI-friendly pseudo-3D engine for the web, inspired by Zdog.",
  "license": "MIT",
  "author": "rxolve",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rxolve/zpup.git"
  },
  "homepage": "https://github.com/rxolve/zpup#readme",
  "bugs": {
    "url": "https://github.com/rxolve/zpup/issues"
  },
  "keywords": [
    "3d",
    "pseudo-3d",
    "svg",
    "canvas",
    "illustration",
    "zdog"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "llms.txt",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p playground/tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "example": "node examples/render.ts",
    "playground:build": "pnpm run build && node playground/build.ts",
    "bench": "node bench/run.ts",
    "bench:report": "node bench/report.ts",
    "bench:models": "node bench/models.ts",
    "prepublishOnly": "pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.14.0",
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^24.19.2",
    "saxes": "^6.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "zdog": "^1.1.3"
  }
}
