#222' }),\n        path({\n          id: 'smile',\n          translate: { y: 12, z: 42 },\n          path: [{ x: -14 }, { bezier: [{ x: -7, y: 10 }, { x: 7, y: 10 }, { x: 14 }] }],\n          stroke: 5,\n          color: '#222',\n        }),\n      ],\n    }),\n  ],\n});\n```\n\nA longer example lives in `examples/pup.ts`.\n\n## Common mistakes\n\n- Radians (`1.57`, `Math.PI / 4`) -> angles are degrees (`90`, `45`).\n- Origin at the top-left as in SVG -> (0, 0) is the center; x and y run from -width/2 to width/2. Negative `y` is up.\n- `fill: \"#fff\"` -> `fill` is true or false; the color goes in `color`: `\"color\": \"#fff\", \"fill\": true`.\n- `stroke: \"#000\"` or `\"12px\"` -> `stroke` is a width in scene units (`2`); its color is `color`.\n- `type: \"circle\"` -> `\"ellipse\"` with `diameter`. `\"line\"` -> `\"path\"` with two points. `\"sphere\"` -> a dot (`path` `[{}]` with a thick stroke). `\"cube\"` -> `\"box\"`.\n- `radius` on an ellipse or round solid -> `diameter`. `height` on a cylinder or cone -> `length`.\n- `color` on a `group` -> set it on the shapes inside.\n\n## Not available yet\n\nCanvas rendering, animation other than `renderSpinSvg`'s constant turn, perspective, React or other framework bindings.\n</reference>"
